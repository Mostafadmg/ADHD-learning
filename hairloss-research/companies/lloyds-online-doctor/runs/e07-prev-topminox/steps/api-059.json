{"step":{"stepState":"SUMMARY","confirmationHref":"/api/questionnaire/traversals/9347222/confirmsummary","answeredQuestions":[{"questionId":100013,"questionText":"What was your sex at birth?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/2668","answers":[{"id":"88","value":"Male","selected":true}]},{"questionId":100014,"questionText":"What is your date of birth?\n","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/2672","answers":[{"id":"100011","value":"15/06/1994","selected":true}]},{"questionId":103257,"questionText":"Please select which of the images below best represents your hair loss","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/2402","answers":[{"id":"102141","value":"Temples and Crown","selected":true}]},{"questionId":107954,"questionText":"How did your hair loss start?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/2603","answers":[{"id":"105143","value":"Gradually, over months or years","selected":true}]},{"questionId":103261,"questionText":"Have you lost any hair in other areas of your body such as eyebrows or beard?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/2060","answers":[{"id":"2","value":"No","selected":true}]},{"questionId":105935,"questionText":"Are you currently experiencing any changes to your scalp?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/4302","answers":[{"id":"2","value":"No","selected":true}]},{"questionId":108014,"questionText":"Have you ever taken any medication for hair loss?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10162/2048","answers":[{"id":"1","value":"Yes","selected":true}]},{"questionId":108015,"questionText":"<p><i>Include any treatments you currently use. Some products contain more than one medication, so please select all that apply.</i></p>","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10162/2179","answers":[{"id":"105205","value":"Topical minoxidil(e.g. Regaine foam, solution or spray, Sons Minoxidil Solution, etc.)","selected":true}]},{"questionId":108016,"questionText":"<p><b>Has Minoxidil spray helped with your hair loss?</b></p><p><i>This could mean slowing or stopping further hair loss, or helping hair grow back.</i></p>","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10162/2228","answers":[{"id":"105630","value":"Yes, it's helped","selected":true}]},{"questionId":107959,"questionText":"Have you ever experienced side effects from Minoxidil spray that:\n<ul>\n  <li>Were persistent</li>\n  <li>Were severe</li>\n  <li>Required medical attention</li>\n  <li>Made you stop using it</li>\n</ul>\n","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10162/2658","answers":[{"id":"2","value":"No","selected":true}]},{"questionId":103270,"questionText":"Have you ever had any of the following conditions?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/2744","answers":[{"id":"999999","value":"None of the above","selected":true}]},{"questionId":101561,"questionText":"Do you have Chronic Kidney Disease (CKD) or a reduced kidney function?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/2877","answers":[{"id":"2","value":"No","selected":true}]},{"questionId":107973,"questionText":"<p>Have you ever had a condition that affects your <b>heart or blood pressure?</b> Examples include:</p>\n<ul><li>High or low blood pressure</li>\n<li>Dizziness or faintness when standing up</li>\n<li>Heart failure</li>\n<li>An irregular heartbeat (arrythmias)</li>\n<li>Fluid or inflammation around the heart</li>\n<li>Heart valve or structural heart problems</li>\n<li>A heart attack, angina, stroke or mini-stroke (TIA)</li>\n<li>Another heart or blood vessel condition</li> </ul>","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/3858","answers":[{"id":"2","value":"No","selected":true}]},{"questionId":107800,"questionText":"Do you have any medical conditions other than those we have already asked about?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/3912","answers":[{"id":"2","value":"No","selected":true}]},{"questionId":102632,"questionText":"\nAre you currently taking any prescription medications?\n","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/3898","answers":[{"id":"2","value":"No","selected":true}]},{"questionId":102624,"questionText":"Do you have any allergies?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/4006","answers":[{"id":"2","value":"No","selected":true}]},{"questionId":108003,"questionText":"Is your partner pregnant, or are you planning or trying for a baby?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/4409","answers":[{"id":"102508","value":"None of the above","selected":true}]},{"questionId":108001,"questionText":"Do you live with pets?","icon":null,"reviewQuestionHref":"/api/questionnaire/traversals/9347222/fromsummary/10052/4381","answers":[{"id":"2","value":"No","selected":true}]}],"summaryRequiredBeforeStep":false,"registrationRequiredBeforeStep":false,"fastSummaryRequiredBeforeStep":false},"explanation":"/api/questionnaire/traversals/9347222/explanations","current":"/api/questionnaire/traversals/9347222/steps/current"}