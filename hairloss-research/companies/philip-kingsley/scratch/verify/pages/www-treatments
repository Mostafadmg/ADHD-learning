  if (!el) return;

  let timer = null;

  function check() {
    const isActive = el.classList.contains('active');

    if (isActive && timer === null) {
      // class was just added — start counting
      timer = setTimeout(() => {
        el.classList.remove('active');
        timer = null;
      }, 3000);
    } else if (!isActive && timer !== null) {
      // class removed before 3s — cancel the countdown
      clearTimeout(timer);
      timer = null;
    }
