      function generateEventData(id, sku, price, name = '')
    {
        let d = {}

        let isContentNameEnabled = 1;

        let identifier = 'sku';

        let contentId = String(sku);

        if (identifier === 'id') {
            contentId = String(id);
        }

        let formattedPrice = parseFloat(parseFloat(price).toFixed(pricePrecision));

        let content = {};
        let contents = [];

        content.content_id = contentId;
        content.quantity = 1;
        content.price = formattedPrice;

        if (name && isContentNameEnabled) {
            content.content_name = String(name);
        }

        contents.push(content);

        d.content_ids = [contentId];

        d.content_type = 'product';
        d.contents = contents;
        d.currency = 'GBP';
        d.value = formattedPrice;

        return d;
