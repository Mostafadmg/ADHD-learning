<script type="text/javascript">
function initMinicartAutoClose() {
  // only run on the checkout/cart page
  if (!/\/checkout\/cart\b/.test(window.location.pathname)) return;

  const el = document.querySelector('.minicart-wrapper');
  if (!el) return;

  let timer = null;

  function check() {
    const isActive = el.classList.contains('active');

    if (isActive && timer === null) {
      // class was just added — start counting
      timer = setTimeout(() => {
        el.classList.remove('active');
        timer = null;
      }, 3000);
    } else if (!isActive && timer !== null) {
      // class removed before 3s — cancel the countdown
      clearTimeout(timer);
      timer = null;
    }
  }

  const observer = new MutationObserver(check);
  observer.observe(el, {
    attributes: true,
    attributeFilter: ['class'],
  });

  // handle the case where it's already active on load
  check();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initMinicartAutoClose);
} else {
  // DOM is already ready
  initMinicartAutoClose();
}
